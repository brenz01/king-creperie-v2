# --- Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Serveur uniquement — bypass RLS. Jamais NEXT_PUBLIC_, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=221XXXXXXXXX
NEXT_PUBLIC_SITE_URL=https://king-creperie-v2.vercel.app

# --- Notifications push (optionnel : sans ces clés, le push est désactivé)
# Générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.com
# Secret partagé avec Supabase Vault (push_dispatch_secret) — openssl rand -hex 32
PUSH_WEBHOOK_SECRET=
